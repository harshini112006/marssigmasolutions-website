{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/iso.html",
      "destination": "/iso-9001.html",
      "permanent": true
    },
    {
      "source": "/iatf.html",
      "destination": "/iatf-16949.html",
      "permanent": true
    },
    {
      "source": "/amc.html",
      "destination": "/system-sustenance.html",
      "permanent": true
    },
    {
      "source": "/system-sustenance-amc.html",
      "destination": "/system-sustenance.html",
      "permanent": true
    },
    {
      "source": "/ims.html",
      "destination": "/ims-integrated.html",
      "permanent": true
    },
    {
      "source": "/ims-iso-9001-14001-45001.html",
      "destination": "/ims-integrated.html",
      "permanent": true
    },
    {
      "source": "/thank-you-iso.html",
      "destination": "/thank-you-iso-9001.html",
      "permanent": true
    },
    {
      "source": "/thank-you-iatf.html",
      "destination": "/thank-you-iatf-16949.html",
      "permanent": true
    },
    {
      "source": "/thank-you-amc.html",
      "destination": "/thank-you-system-sustenance.html",
      "permanent": true
    },
    {
      "source": "/thank-you-system-sustenance-amc.html",
      "destination": "/thank-you-system-sustenance.html",
      "permanent": true
    },
    {
      "source": "/thank-you-ims.html",
      "destination": "/thank-you-ims-integrated.html",
      "permanent": true
    },
    {
      "source": "/thank-you-ims-iso-9001-14001-45001.html",
      "destination": "/thank-you-ims-integrated.html",
      "permanent": true
    }
  ]
}
